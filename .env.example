# --- Reverse image search (required for social_search.py) ---
# Google Cloud Vision API key (Web Detection feature). Free tier: 1,000
# units/month. See README.md for how to create one.
GOOGLE_VISION_API_KEY=

# --- Privacy: salts the face embedding before hashing so the same face
# scanned twice on different machines still hashes identically, without
# ever exposing the raw embedding. Change this to any secret string. ---
EMBEDDING_SALT=change-me-to-a-random-secret

# --- Optional: real blockchain anchoring ---
# Leave all three blank to use the built-in local simulated chain instead.
# Works with any EVM-compatible network: Polygon Amoy, Ethereum Sepolia,
# a local Anvil/Ganache node, or mainnet.
RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
